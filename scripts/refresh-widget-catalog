#!/usr/bin/env python3
"""Bounded workaround for stale Omarchy 4.0.4 widget contexts after a bar swap.

Only requests the documented plugin rescan; never restarts/kills the shell,
changes config, or accesses auth. A runtime-only cooldown prevents reload loops.
"""
import fcntl
import os
from pathlib import Path
import stat
import subprocess
import sys
import time


def refresh(reset=False):
    runtime = os.environ.get('XDG_RUNTIME_DIR', '')
    if not runtime or not Path(runtime).is_absolute():
        return 1
    path = Path(runtime) / 'drona-mac-catalog.lock'
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'r+') as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
            return 1
        fcntl.flock(stream, fcntl.LOCK_EX)
        try:
            previous = float(stream.read(64) or '0')
        except ValueError:
            return 1
        now = time.monotonic()
        if not reset and 0 < now - previous < 30:
            return 0
        stream.seek(0)
        stream.truncate()
        stream.write('0' if reset else str(now))
        stream.flush()
        if reset:
            return 0
        return subprocess.run(['omarchy-shell', 'shell', 'rescanPlugins'], timeout=10, check=False).returncode


if __name__ == '__main__':
    try:
        sys.exit(refresh(reset=sys.argv[1:] == ['--reset']))
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print('Mac Desktop catalog refresh:', exc, file=sys.stderr)
        sys.exit(1)
